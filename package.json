{
  "name": "bh-site",
  "version": "1.0.0",
  "description": "БХ — цех обладнання для переробки вторсировини: каталог, вироби з кришечок, послуги ЧПУ, партнерство, вакансії",
  "private": true,
  "main": "server/index.js",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --no-warnings server/index.js",
    "dev": "node --no-warnings --watch server/index.js",
    "test": "node --no-warnings --test test/*.test.js",
    "reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true})\""
  }
}
